# Keep this file on your own PC. Never publish the bot token.
DISCORD_TOKEN=
GUILD_ID=
OWNER_ID=
# true = relay human participants in the selected Discord voice channel.
# false = only the owner's microphone goes to Nekto.
RELAY_ALL_MEMBERS=true

# Your existing Nekto session tokens. Leave blank for normal site-created sessions.
NEKTO_AUTH_TOKEN_1=
NEKTO_AUTH_TOKEN_2=

# auto: installed Chrome, then Edge, then existing Playwright Chromium.
BROWSER_CHANNEL=auto
# Optional full executable path for an unusual/portable install. No surrounding quotes.
CHROMIUM_EXECUTABLE=

# Railway sets this to a persistent volume mount.
NEKTO_DATA_DIR=
# Optional startup inspection of callers with configured tokens; does not start calls.
NEKTO_PRELOAD=false
